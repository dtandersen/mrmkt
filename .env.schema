# API provider credentials for Pi (models.json) and OpenCode (opencode.jsonc).
# Safe to commit: secret keys are resolved from the pass store via the
# pass plugin (@varlock/pass-plugin) — only entry paths are stored here, never values.
# Expected pass layout: <ENV_VAR_NAME> (e.g. NVIDIA_API_KEY)
# @plugin(@varlock/pass-plugin@1.0.1)
# @initPass()
# @plugin(@varlock/hashicorp-vault-plugin@2.1.1)
# @initHcpVault(url="https://vault.home.davidandersen.us")
# @defaultSensitive=false
# @defaultRequired=true
# ---

# @sensitive=true
# @required=false
# @type=string(optional=true)
# Tries Vault first; falls back to the pass store when Vault is unusable
# on this host (no ~/.vault-token, or the server is unreachable/unsealed
# check fails). VAULT_USABLE probes health without triggering the plugin's
# "No Vault authentication found" SchemaError.
VAULT_USABLE=if(
  eq(
    exec("bash -c 'test -f ~/.vault-token && curl -s -m 3 -o /dev/null -w %{http_code} https://vault.home.davidandersen.us/v1/sys/health | grep -qE \"(200|429|472|473|501|503)\" && echo yes || echo no'"),
    "yes"
  ),
  "yes",
  "no"
)

# @sensitive=true
# @required=false
# @type=string(optional=true)
OPENROUTER_API_KEY=if(
  eq(ref(VAULT_USABLE), "yes"),
  vaultSecret("secret/llm"),
  pass("OPENROUTER_API_KEY", allowMissing=true)
)

# @sensitive=true
# @required=false
# @type=string(optional=true)
TRITONAI_API_KEY=pass("TRITONAI_API_KEY", allowMissing=true)
